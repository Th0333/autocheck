<Application x:Class="NotebookCheck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NotebookCheck.Presentation.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Presentation/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StepConverter x:Key="StepConv"/>
            <conv:StepTitleConverter x:Key="StepTitleConv"/>
            <conv:InverseBooleanConverter x:Key="InvBoolConv"/>
            <conv:SimNaoConverter x:Key="SimNaoConv"/>
            <conv:StatusBackgroundConverter x:Key="StatusBgConv"/>
            <conv:StatusForegroundConverter x:Key="StatusFgConv"/>
            <conv:BoolToVisibilityConverter x:Key="BoolVisConv"/>
            <conv:PhotoCheckConverter x:Key="PhotoCheckConv"/>
            <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyVisConv"/>
            <conv:BoolToErrorBrushConverter x:Key="ErrorBrushConv"/>
            <conv:StepIndexConverter x:Key="StepIndexConv"/>
            <conv:CountToVisibilityConverter x:Key="CountVisConv"/>
            <conv:PortBgConverter x:Key="PortBgConv"/>
            <conv:PortBorderConverter x:Key="PortBorderConv"/>
            <conv:PortLabelConverter x:Key="PortLabelConv"/>
            <conv:PercentWidthConverter x:Key="PercentWidthConv"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
