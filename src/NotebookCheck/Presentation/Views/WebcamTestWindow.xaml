<views:TestResultWindow x:Class="NotebookCheck.Presentation.Views.WebcamTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        xmlns:views="clr-namespace:NotebookCheck.Presentation.Views"
        Title="Teste da câmera"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{StaticResource Ink50Brush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ModalTitleBar Grid.Row="0" Title="Teste da câmera"/>

        <DockPanel Grid.Row="1" LastChildFill="True" Margin="20">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Teste da câmera"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Subtle}" Margin="0,6,0,16" TextWrapping="Wrap"
                       Text="A câmera vai abrir em uma janela do Windows. Verifique se a imagem aparece, se está nítida e sem manchas, e depois feche para registrar o resultado."/>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Câmeras detectadas" Style="{StaticResource Label}"/>
                    <ItemsControl x:Name="camList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,0,0,4" Foreground="{StaticResource Ink800Brush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="emptyHint" Text="Nenhuma câmera encontrada" Foreground="{StaticResource BadBrush}"
                               Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Câmera não funciona" Style="{StaticResource BtnGhost}" Click="OnFailed"/>
                <Button Content="Câmera OK" Style="{StaticResource BtnPrimary}" Click="OnOk"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Subtle}" Text="A câmera abre na app integrada do Windows" HorizontalAlignment="Center"/>
                    <Button Content="🎥  Abrir câmera" Style="{StaticResource BtnPrimary}" Margin="0,12,0,0"
                            Click="OnOpenCamera" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lastError" Foreground="{StaticResource BadBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="500"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</views:TestResultWindow>
