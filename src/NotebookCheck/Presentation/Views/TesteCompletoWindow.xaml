<Window x:Class="NotebookCheck.Presentation.Views.TesteCompletoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        Title="Notelet — Teste completo"
        Width="780" Height="860"
        MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource Ink50Brush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:ModalTitleBar Grid.Row="0" Title="Teste completo (check automático)"/>

        <!-- Cabeçalho -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource Ink200Brush}"
                BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="{Binding StepNumberLabel}"/>
                <TextBlock Style="{StaticResource H1}" Margin="0,2,0,0" Text="{Binding StepTitle}"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="22,18"
                      Visibility="{Binding IsDone, Converter={StaticResource BoolVisConv}, ConverterParameter=invert}">
            <Grid>
                <!-- ============ ETAPA 1: PEDIDO DE COMPRA + MÁQUINA ============ -->
                <StackPanel Visibility="{Binding IsSelecao, Converter={StaticResource BoolVisConv}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource H2}" Text="🧾 Pedido de compra *"/>
                                <Button Content="⟳ Recarregar" Style="{StaticResource BtnGhost}"
                                        HorizontalAlignment="Right" Padding="10,4"
                                        Command="{Binding RecarregarFilaCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="Só aparecem os pedidos que têm máquina esperando o teste completo."/>

                            <ComboBox ItemsSource="{Binding Pedidos}" SelectedItem="{Binding SelectedPedido}"
                                      DisplayMemberPath="Display" IsEditable="False"
                                      Visibility="{Binding TemFila, Converter={StaticResource BoolVisConv}}"/>

                            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                       Visibility="{Binding FilaVaziaInfo, Converter={StaticResource BoolVisConv}}"
                                       Text="Nenhuma máquina aguardando teste completo. Faça o check de entrada primeiro (Cadastro no estoque)."/>
                        </StackPanel>
                    </Border>

                    <!-- Máquina do pedido -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding PedidoSelecionado, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="💻 Máquina do pedido *"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="Qual máquina deste pedido está na sua bancada?"/>
                            <ComboBox ItemsSource="{Binding MaquinasDoPedido}" SelectedItem="{Binding SelectedMaquina}"
                                      DisplayMemberPath="Display"/>

                            <Border Margin="0,12,0,0" Padding="14" CornerRadius="8"
                                    Background="{DynamicResource Ink50Brush}"
                                    Visibility="{Binding MaquinaSelecionada, Converter={StaticResource BoolVisConv}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Etapa no kanban" Foreground="{DynamicResource Ink500Brush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MaquinaEtapa}"/>
                                        <TextBlock Grid.Row="1" Text="Config acordada" Foreground="{DynamicResource Ink500Brush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfigAcordadaText}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Text="Serial desta máquina" Foreground="{DynamicResource Ink500Brush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SpecSerial}"
                                                   FontFamily="{StaticResource MonoFont}"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" Padding="10" CornerRadius="6"
                                            Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource WarnBrush}"
                                            Visibility="{Binding JaReportado, Converter={StaticResource BoolVisConv}}">
                                        <TextBlock Text="{Binding JaReportadoAviso}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource WarnBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Subtle}" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="Ao iniciar, o app lê as especificações, roda a bateria de testes e envia tudo para o ERP sozinho. Depois pergunta se você quer mandar fotos."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ETAPA 2: RODANDO + REPORTANDO ================== -->
                <StackPanel Visibility="{Binding IsExecutando, Converter={StaticResource BoolVisConv}}">
                    <!-- em execução -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding Rodando, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="⚙️ Rodando"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding ProgressoTexto}"
                                       Foreground="{DynamicResource Ink600Brush}"/>
                            <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,0,0"
                                         Background="Transparent" Foreground="{StaticResource BrandBrush}"
                                         BorderThickness="0"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Não desligue nem feche a tampa. Ao terminar, o resultado vai para o ERP automaticamente."/>
                        </StackPanel>
                    </Border>

                    <!-- reportado -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding TemResultado, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource H2}" Text="✅ Enviado ao ERP"/>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Text="{Binding ResultadoLabel}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{Binding ReportadoTexto}"/>
                            <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding TestesResumo}"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="{Binding SpecsResumo}"/>
                        </StackPanel>
                    </Border>

                    <!-- erro -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding ErroExecucao, Converter={StaticResource NotEmptyVisConv}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="⚠️ Não deu certo"
                                       Foreground="{StaticResource BadBrush}"/>
                            <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Text="{Binding ErroExecucao}"/>
                            <Button Content="Tentar de novo" Style="{StaticResource BtnPrimary}"
                                    HorizontalAlignment="Left" Command="{Binding TentarDeNovoCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- divergências de configuração -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding TemConfigDivergencias, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="⚠️ Configuração fora do acordado"
                                       Foreground="{StaticResource WarnBrush}"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,8" TextWrapping="Wrap"
                                       Text="Foi junto no envio, como alerta para quem der o OK no ERP."/>
                            <TextBlock Text="{Binding ConfigDivergenciasText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- grade de testes -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <ItemsControl ItemsSource="{Binding Testes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Ink200Brush}" BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{DynamicResource Ink500Brush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="999"
                                                    Padding="9,3" Margin="10,0,0,0"
                                                    Background="{DynamicResource Ink100Brush}">
                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink700Brush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- ajustes opcionais (o app não vê a caixa: acessórios são humanos) -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding TemResultado, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding AjustesAbertos}"
                                      Content="Faltou acessório ou quer deixar uma observação?"
                                      FontWeight="SemiBold"/>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding AjustesAbertos, Converter={StaticResource BoolVisConv}}">
                                <StackPanel Visibility="{Binding TemAcessoriosObrigatorios, Converter={StaticResource BoolVisConv}}">
                                    <TextBlock Style="{StaticResource Label}" Text="ACESSÓRIOS OBRIGATÓRIOS DO PEDIDO"/>
                                    <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,6" TextWrapping="Wrap"
                                               Text="Desmarque o que NÃO veio com a máquina."/>
                                    <ItemsControl ItemsSource="{Binding AcessoriosChecklist}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Nome}" IsChecked="{Binding Veio}" Margin="0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Label}" Margin="0,10,0,4" Text="OBSERVAÇÕES"/>
                                <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                         VerticalScrollBarVisibility="Auto"/>

                                <Button Content="Atualizar no ERP" Style="{StaticResource BtnGhost}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Command="{Binding AtualizarNoErpCommand}"
                                        IsEnabled="{Binding Atualizando, Converter={StaticResource InvBoolConv}}"/>
                                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Substitui os dados desta máquina no ERP pelo que está aqui."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ETAPA 3: FOTOS ================================= -->
                <StackPanel Visibility="{Binding IsFotos, Converter={StaticResource BoolVisConv}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="📸 Quer enviar fotos desta máquina?"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,12" TextWrapping="Wrap"
                                       Text="Vão direto para o ERP, junto da máquina. É opcional — dá para finalizar sem foto."/>

                            <UniformGrid Columns="2">
                                <Border CornerRadius="10" Margin="0,0,6,0" Padding="2"
                                        BorderBrush="{DynamicResource Ink200Brush}" BorderThickness="1">
                                    <Button Background="Transparent" BorderThickness="0" Padding="14" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding UsarWebcamCommand}">
                                        <StackPanel>
                                            <TextBlock Text="📷" FontSize="24" HorizontalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource H2}" HorizontalAlignment="Center"
                                                       Text="Webcam" Margin="0,6,0,4"/>
                                            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Text="A câmera da bancada, apontada para a máquina."/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <Border CornerRadius="10" Margin="6,0,0,0" Padding="2"
                                        BorderBrush="{DynamicResource Ink200Brush}" BorderThickness="1">
                                    <Button Background="Transparent" BorderThickness="0" Padding="14" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding UsarQrCommand}">
                                        <StackPanel>
                                            <TextBlock Text="📱" FontSize="24" HorizontalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource H2}" HorizontalAlignment="Center"
                                                       Text="QR code" Margin="0,6,0,4"/>
                                            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Text="Leia com o celular e tire as fotos por lá."/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </UniformGrid>

                            <Border Margin="0,12,0,0" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource BadBrush}"
                                    Visibility="{Binding FotoErro, Converter={StaticResource NotEmptyVisConv}}">
                                <TextBlock Text="{Binding FotoErro}" TextWrapping="Wrap"
                                           Foreground="{StaticResource BadBrush}"/>
                            </Border>

                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding FotosResumo}"/>
                        </StackPanel>
                    </Border>

                    <!-- Webcam -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding UsandoWebcam, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Câmera"/>
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Cameras}"
                                      SelectedItem="{Binding SelectedCamera}" DisplayMemberPath="Nome"
                                      Visibility="{Binding CameraLigada, Converter={StaticResource BoolVisConv}}"/>
                            <Button Content="Trocar para esta câmera" Style="{StaticResource BtnGhost}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding TrocarCameraCommand}"
                                    Visibility="{Binding CameraLigada, Converter={StaticResource BoolVisConv}}"/>

                            <Border Margin="0,10,0,0" CornerRadius="8" Background="{StaticResource DarkPanelBrush}"
                                    MinHeight="240"
                                    Visibility="{Binding CameraLigada, Converter={StaticResource BoolVisConv}}">
                                <Image Source="{Binding CameraFrame}" Stretch="Uniform" MaxHeight="360"/>
                            </Border>

                            <Button Content="📸 Tirar foto e enviar" Style="{StaticResource BtnPrimary}"
                                    Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Command="{Binding TirarFotoCommand}"
                                    IsEnabled="{Binding PodeTirarFoto}"/>
                            <ProgressBar Width="140" Height="4" IsIndeterminate="True" HorizontalAlignment="Left"
                                         Margin="0,6,0,0" Background="Transparent"
                                         Foreground="{StaticResource BrandBrush}" BorderThickness="0"
                                         Visibility="{Binding EnviandoFoto, Converter={StaticResource BoolVisConv}}"/>
                        </StackPanel>
                    </Border>

                    <!-- QR code -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding UsandoQr, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Leia com o celular"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="Abra a câmera do celular e aponte. A página abre sem login e as fotos vão direto para o ERP. O link vale 2 horas e é só desta máquina."/>

                            <Border HorizontalAlignment="Center" Padding="12" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource Ink200Brush}" BorderThickness="1"
                                    Visibility="{Binding TemQr, Converter={StaticResource BoolVisConv}}">
                                <Image Source="{Binding QrImagem}" Width="240" Height="240"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <TextBox Margin="0,10,0,0" Text="{Binding QrUrl, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Center" TextAlignment="Center"/>

                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Text="{Binding FotosResumo}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Subtle}" HorizontalAlignment="Center"
                                       Text="Atualiza sozinho conforme as fotos chegam."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Tela final -->
        <Border Grid.Row="2" Padding="40" VerticalAlignment="Center"
                Visibility="{Binding IsDone, Converter={StaticResource BoolVisConv}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                <TextBlock Text="✅" FontSize="56" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource H1}" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,12,0,8" Text="Check automático concluído"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Ink600Brush}"
                           Text="{Binding ReportadoTexto}"/>
                <TextBlock Margin="0,6,0,0" TextAlignment="Center" Foreground="{DynamicResource Ink500Brush}"
                           Text="{Binding FotosResumo}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="Testar outra" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0"
                            Command="{Binding TestarOutraCommand}"/>
                    <Button Content="Fechar" Style="{StaticResource BtnGhost}"
                            Command="{Binding FecharCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Rodapé -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource Ink200Brush}"
                BorderThickness="0,1,0,0" Padding="22,12"
                Visibility="{Binding IsDone, Converter={StaticResource BoolVisConv}, ConverterParameter=invert}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Ink600Brush}"/>
                    <ProgressBar Width="140" Height="4" IsIndeterminate="True" HorizontalAlignment="Left" Margin="0,6,0,0"
                                 Background="Transparent" Foreground="{StaticResource BrandBrush}" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVisConv}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- etapa 1 -->
                    <Button Content="▶ Iniciar check automático" Style="{StaticResource BtnPrimary}"
                            Command="{Binding IniciarCheckCommand}"
                            IsEnabled="{Binding PodeIniciar}"
                            Visibility="{Binding IsSelecao, Converter={StaticResource BoolVisConv}}"/>

                    <!-- etapa 2 -->
                    <Button Content="← Trocar máquina" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding VoltarParaSelecaoCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolVisConv}}"/>
                    <Button Content="Continuar → Fotos" Style="{StaticResource BtnPrimary}"
                            Command="{Binding IrParaFotosCommand}"
                            Visibility="{Binding PodeIrParaFotos, Converter={StaticResource BoolVisConv}}"/>

                    <!-- etapa 3 -->
                    <Button Content="Finalizar" Style="{StaticResource BtnPrimary}"
                            Command="{Binding FinalizarCommand}"
                            Visibility="{Binding IsFotos, Converter={StaticResource BoolVisConv}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
