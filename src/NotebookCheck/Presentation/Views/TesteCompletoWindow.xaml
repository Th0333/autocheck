<Window x:Class="NotebookCheck.Presentation.Views.TesteCompletoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        Title="Notelet — Teste completo"
        Width="780" Height="860"
        MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{StaticResource Ink50Brush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:ModalTitleBar Grid.Row="0" Title="Teste completo (check automático)"/>

        <!-- Cabeçalho: etapa atual + passos -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Ink200Brush}"
                BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="{Binding StepNumberLabel}"/>
                <TextBlock Style="{StaticResource H1}" Margin="0,2,0,12" Text="{Binding StepTitle}"/>
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <Button Content="① Máquina" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"
                            Command="{Binding GoToStepCommand}" CommandParameter="0"/>
                    <Button Content="② Especificações" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"
                            Command="{Binding GoToStepCommand}" CommandParameter="1"/>
                    <Button Content="③ Condição" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"
                            Command="{Binding GoToStepCommand}" CommandParameter="2"/>
                    <Button Content="④ Testes" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"
                            Command="{Binding GoToStepCommand}" CommandParameter="3"/>
                    <Button Content="⑤ Revisão" Style="{StaticResource BtnGhost}"
                            Command="{Binding GoToStepCommand}" CommandParameter="4"/>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Conteúdo do wizard -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="22,18"
                      Visibility="{Binding IsDone, Converter={StaticResource BoolVisConv}, ConverterParameter=invert}">
            <Grid>
                <!-- =================== ETAPA 1: MÁQUINA DA FILA =============== -->
                <StackPanel Visibility="{Binding IsMaquina, Converter={StaticResource BoolVisConv}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource H2}" Text="💻 Máquina na bancada *"/>
                                <Button Content="⟳ Recarregar" Style="{StaticResource BtnGhost}"
                                        HorizontalAlignment="Right" Padding="10,4"
                                        Command="{Binding RecarregarFilaCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="Escolha a máquina que está na sua bancada. A lista traz tudo que está aguardando o teste completo no ERP."/>

                            <ComboBox ItemsSource="{Binding Fila}" SelectedItem="{Binding SelectedMaquina}"
                                      DisplayMemberPath="Display" IsEditable="False"
                                      Visibility="{Binding TemFila, Converter={StaticResource BoolVisConv}}"/>

                            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                       Visibility="{Binding FilaVaziaInfo, Converter={StaticResource BoolVisConv}}"
                                       Text="Nenhuma máquina aguardando teste completo. Faça o check de entrada primeiro (Cadastro no estoque)."/>

                            <!-- Detalhes da máquina escolhida -->
                            <Border Margin="0,10,0,0" Padding="14" CornerRadius="8"
                                    Background="{StaticResource Ink50Brush}"
                                    Visibility="{Binding MaquinaSelecionada, Converter={StaticResource BoolVisConv}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Etapa no kanban" Foreground="{StaticResource Ink500Brush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MaquinaEtapa}"/>
                                        <TextBlock Grid.Row="1" Text="Pedido de origem" Foreground="{StaticResource Ink500Brush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MaquinaPedido}"/>
                                        <TextBlock Grid.Row="2" Text="Config acordada" Foreground="{StaticResource Ink500Brush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfigAcordadaText}" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Border Margin="0,10,0,0" Padding="10" CornerRadius="6"
                                            Background="White" BorderThickness="1" BorderBrush="{StaticResource WarnBrush}"
                                            Visibility="{Binding JaReportado, Converter={StaticResource BoolVisConv}}">
                                        <TextBlock Text="{Binding JaReportadoAviso}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource WarnBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- =================== ETAPA 2: ESPECIFICAÇÕES ================ -->
                <StackPanel Visibility="{Binding IsEspecificacoes, Converter={StaticResource BoolVisConv}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="🔧 Especificações detectadas"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="Lidas da própria máquina. Vão para a ficha técnica no ERP como a versão vigente."/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Processador" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SpecProcessador}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Memória RAM" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpecRam}"/>
                                <TextBlock Grid.Row="2" Text="Armazenamento" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SpecStorage}"/>
                                <TextBlock Grid.Row="3" Text="GPU" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SpecGpu}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="4" Text="Resolução" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SpecResolucao}"/>
                                <TextBlock Grid.Row="5" Text="Sistema" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SpecSo}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="6" Text="Saúde da bateria" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SpecBateria}"/>
                                <TextBlock Grid.Row="7" Text="Número de série" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SpecSerial}"
                                           FontFamily="{StaticResource MonoFont}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- =================== ETAPA 3: CONDIÇÃO ====================== -->
                <StackPanel Visibility="{Binding IsCondicao, Converter={StaticResource BoolVisConv}}">
                    <!-- Config acordada × real -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding TemConfigAcordada, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="📋 Configuração do pedido"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="O que foi comprado, comparado com o que está nesta máquina."/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Acordado" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConfigAcordadaText}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Encontrado" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpecsResumo}" TextWrapping="Wrap"/>
                            </Grid>

                            <Border Margin="0,12,0,0" Padding="12" CornerRadius="6"
                                    Background="White" BorderThickness="1" BorderBrush="{StaticResource WarnBrush}"
                                    Visibility="{Binding TemConfigDivergencias, Converter={StaticResource BoolVisConv}}">
                                <StackPanel>
                                    <TextBlock Text="⚠️ O app encontrou diferenças:" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarnBrush}"/>
                                    <TextBlock Text="{Binding ConfigDivergenciasText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{StaticResource Ink700Brush}"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{StaticResource Ink200Brush}" Margin="0,14"/>

                            <TextBlock Text="A configuração desta máquina bate com o pedido?" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,8" TextWrapping="Wrap"
                                       Text="Você decide. O app pode não enxergar um pente de RAM a mais, e o pedido pode ter sido renegociado."/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Sim, bate" GroupName="ConfigConfere" Margin="0,0,20,0"
                                             IsChecked="{Binding ConfigConfere}"/>
                                <RadioButton Content="Não bate" GroupName="ConfigConfere"
                                             IsChecked="{Binding ConfigNaoConfere}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Acessórios obrigatórios -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding TemAcessoriosObrigatorios, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="🎒 Acessórios obrigatórios"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="Desmarque o que NÃO veio com a máquina. O que faltar vira alerta no ERP."/>
                            <ItemsControl ItemsSource="{Binding AcessoriosChecklist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Nome}" IsChecked="{Binding IsChecked}" Margin="0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,10,0,0" Padding="12" CornerRadius="6"
                                    Background="White" BorderThickness="1" BorderBrush="{StaticResource WarnBrush}"
                                    Visibility="{Binding TemAcessoriosFaltando, Converter={StaticResource BoolVisConv}}">
                                <TextBlock Text="{Binding AcessoriosAvisoText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Observações -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="📝 Observações"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,8" TextWrapping="Wrap"
                                       Text="Qualquer coisa que quem vai dar o OK no ERP precise saber."/>
                            <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- =================== ETAPA 4: TESTES ======================== -->
                <StackPanel Visibility="{Binding IsTestes, Converter={StaticResource BoolVisConv}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="🧪 Testes automáticos"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,12" TextWrapping="Wrap"
                                       Text="RAM, disco (SMART), bateria, carregador, HDMI, Wi-Fi, Bluetooth, áudio, USB e mais. Cada teste vai para o ERP com o detalhe do que foi medido."/>

                            <Button Content="▶ Rodar testes" Style="{StaticResource BtnPrimary}"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RodarTestesCommand}"
                                    IsEnabled="{Binding PodeRodarTestes}"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding TestesRodando, Converter={StaticResource BoolVisConv}}">
                                <TextBlock Text="{Binding TesteAtual}" Foreground="{StaticResource Ink600Brush}"/>
                                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,6,0,0"
                                             Background="Transparent" Foreground="{StaticResource BrandBrush}"
                                             BorderThickness="0"/>
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding TestesResumo}"
                                       Visibility="{Binding TestesConcluidos, Converter={StaticResource BoolVisConv}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <ItemsControl ItemsSource="{Binding Testes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Ink200Brush}" BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{StaticResource Ink500Brush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="999"
                                                    Padding="9,3" Margin="10,0,0,0"
                                                    Background="{StaticResource Ink100Brush}">
                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink700Brush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- =================== ETAPA 5: REVISÃO ======================= -->
                <StackPanel Visibility="{Binding IsRevisao, Converter={StaticResource BoolVisConv}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="✅ Resultado do teste"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                       Text="Sugerido a partir dos testes. Você pode mudar antes de enviar."/>
                            <ComboBox ItemsSource="{Binding Resultados}" SelectedItem="{Binding SelectedResultado}"
                                      DisplayMemberPath="Label"/>

                            <Border Height="1" Background="{StaticResource Ink200Brush}" Margin="0,14"/>

                            <TextBlock Style="{StaticResource Label}" Text="MÁQUINA" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Máquina" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding RevMaquina}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Ordem" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RevOrdem}"/>
                                <TextBlock Grid.Row="2" Text="Pedido" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RevPedido}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource Ink200Brush}" Margin="0,12"/>
                            <TextBlock Style="{StaticResource Label}" Text="CONDIÇÃO" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Config acordada" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding RevConfigAcordada}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Confere?" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RevConfigConfere}"/>
                                <TextBlock Grid.Row="2" Text="Acessórios faltando" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RevAcessoriosFaltantes}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3" Text="Observações" Foreground="{StaticResource Ink500Brush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RevObservacoes}" TextWrapping="Wrap"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource Ink200Brush}" Margin="0,12"/>
                            <TextBlock Style="{StaticResource Label}" Text="TESTES" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding RevTestes}"/>

                            <Border Margin="0,14,0,0" Padding="12" CornerRadius="6"
                                    Background="{StaticResource Ink50Brush}">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink600Brush}"
                                           Text="Ao enviar, a ordem continua aberta no ERP com estes dados. Alguém confere e dá o OK — só então a máquina segue para a aprovação de entrada."/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Tela de sucesso -->
        <Border Grid.Row="2" Padding="40" VerticalAlignment="Center"
                Visibility="{Binding IsDone, Converter={StaticResource BoolVisConv}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                <TextBlock Text="✅" FontSize="56" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource H1}" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,12,0,8" Text="Check automático enviado"/>
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource Ink600Brush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="Testar outra" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0"
                            Command="{Binding NovoTesteCommand}"/>
                    <Button Content="Fechar" Style="{StaticResource BtnGhost}"
                            Command="{Binding FecharCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Rodapé: status + navegação -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Ink200Brush}"
                BorderThickness="0,1,0,0" Padding="22,12"
                Visibility="{Binding IsDone, Converter={StaticResource BoolVisConv}, ConverterParameter=invert}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource Ink600Brush}"/>
                    <ProgressBar Width="140" Height="4" IsIndeterminate="True" HorizontalAlignment="Left" Margin="0,6,0,0"
                                 Background="Transparent" Foreground="{StaticResource BrandBrush}" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVisConv}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="← Voltar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolVisConv}}"/>
                    <Button Content="{Binding NextLabel}" Style="{StaticResource BtnPrimary}"
                            Command="{Binding NextCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolConv}}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolVisConv}, ConverterParameter=invert}"/>
                    <Button Content="📤 Enviar check automático" Style="{StaticResource BtnPrimary}"
                            Command="{Binding EnviarCommand}"
                            IsEnabled="{Binding PodeEnviar}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolVisConv}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
