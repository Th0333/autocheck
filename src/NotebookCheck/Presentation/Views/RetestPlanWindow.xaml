<Window x:Class="NotebookCheck.Presentation.Views.RetestPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        Title="Plano do reteste"
        Width="680" Height="600"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource Ink50Brush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ModalTitleBar Grid.Row="0" Title="Plano do reteste"/>

        <DockPanel Grid.Row="1" LastChildFill="True" Margin="20">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource H2}" Text="🔁 Reteste do equipamento"/>
                <TextBlock x:Name="baseInfo" Style="{StaticResource Subtle}" Margin="0,4,0,12" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Ações -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button x:Name="onlyFailuresBtn" Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Stretch" Click="OnOnlyFailures"/>
                <Button Style="{StaticResource BtnBase}" Margin="0,8,0,0"
                        HorizontalAlignment="Stretch" Click="OnFullOverwrite"
                        Content="📋 Refazer o checklist completo (sobrescreve o relatório antigo)"/>
                <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,8,0,0"
                        HorizontalAlignment="Right" Click="OnCancel"/>
            </StackPanel>

            <!-- Lista de falhas do relatório anterior -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}"
                               Text="O QUE CONSTOU COMO PROBLEMA NO RELATÓRIO ANTERIOR"/>
                    <TextBlock x:Name="noFailuresText" DockPanel.Dock="Top" Margin="0,10,0,0"
                               Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{DynamicResource Ink600Brush}"
                               Text="Nenhuma falha ou atenção registrada no relatório anterior. Você ainda pode refazer o checklist completo por cima."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl x:Name="failuresList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                                            Background="{DynamicResource Ink50Brush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink900Brush}"/>
                                                <TextBlock Text="{Binding Details}" FontSize="12" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Ink600Brush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="999" Padding="10,3"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding Status, Converter={StaticResource StatusBgConv}}">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusFgConv}}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
