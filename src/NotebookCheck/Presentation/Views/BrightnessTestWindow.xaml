<views:TestResultWindow x:Class="NotebookCheck.Presentation.Views.BrightnessTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        xmlns:views="clr-namespace:NotebookCheck.Presentation.Views"
        Title="Teste de brilho"
        Width="560" Height="460"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource Ink50Brush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ModalTitleBar Grid.Row="0" Title="Teste de brilho da tela"/>

        <DockPanel Grid.Row="1" LastChildFill="True" Margin="20">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource H2}" Text="☀ Brilho da tela"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,14" TextWrapping="Wrap"
                           Text="Arraste o controle e confirme que o brilho do painel responde em toda a faixa (do mínimo ao máximo). Ao fechar, o brilho original é restaurado."/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Marcar como falho" Style="{StaticResource BtnGhost}" Click="OnFailed"/>
                <Button Content="✓ Funciona" Style="{StaticResource BtnSuccess}" Click="OnOk"/>
            </StackPanel>

            <!-- Suportado: slider + atalhos -->
            <Border x:Name="supportedPanel" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="NÍVEL DE BRILHO"/>
                    <TextBlock x:Name="valueText" Text="—" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource BrandBrush}" Margin="0,2,0,8"/>
                    <Slider x:Name="slider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="20"
                            IsSnapToTickEnabled="False" TickFrequency="10"
                            ValueChanged="OnSliderChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Mínimo" Style="{StaticResource BtnBase}" Margin="0,0,8,0" Click="OnMin"/>
                        <Button Content="50%" Style="{StaticResource BtnBase}" Margin="0,0,8,0" Click="OnMid"/>
                        <Button Content="Máximo" Style="{StaticResource BtnBase}" Click="OnMax"/>
                    </StackPanel>
                    <TextBlock x:Name="hintText" Style="{StaticResource Subtle}" Margin="0,16,0,0" TextWrapping="Wrap"
                               Text="Dica: observe se a tela escurece e clareia de fato ao mover o controle."/>
                </StackPanel>
            </Border>

            <!-- Não suportado -->
            <Border x:Name="unsupportedPanel" Style="{StaticResource Card}" Padding="20"
                    VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="⚠ Controle de brilho por software indisponível"
                               FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource WarnBrush}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="O driver deste painel não expõe ajuste de brilho via WMI (comum em desktops e monitores externos). Ajuste o brilho pelas teclas de função (Fn) do teclado, confirme visualmente que responde e marque o resultado manualmente."/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</views:TestResultWindow>
