<Window x:Class="NotebookCheck.Presentation.Views.FinalDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        Title="Decisão final"
        Width="640" Height="600"
        MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{StaticResource Ink50Brush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ModalTitleBar Grid.Row="0" Title="Decisão final"/>

        <DockPanel Grid.Row="1" LastChildFill="True" Margin="22">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource H2}" Text="Aprovação do equipamento"/>
                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,16"
                           Text="Com base nos testes e na inspeção, o sistema sugere a classificação abaixo. Você pode alterar antes de salvar e enviar o relatório."/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Click="OnCancel"/>
                <Button Content="Confirmar e enviar" Style="{StaticResource BtnSuccess}" Click="OnConfirm"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="SUGERIDO PELO SISTEMA"/>
                            <TextBlock x:Name="suggestedText" Margin="0,4,0,0" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="DECISÃO DO TÉCNICO"/>
                            <RadioButton x:Name="optApproved" GroupName="Decision" Margin="0,10,0,4">
                                <StackPanel>
                                    <TextBlock Text="Aprovado" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}"/>
                                    <TextBlock Text="Equipamento liberado para venda" Style="{StaticResource Subtle}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="optWarn" GroupName="Decision" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="Aprovado com ressalvas" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                                    <TextBlock Text="Pode vender, mas há observações" Style="{StaticResource Subtle}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="optRejected" GroupName="Decision" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Reprovado" FontWeight="SemiBold" Foreground="{StaticResource BadBrush}"/>
                                    <TextBlock Text="Equipamento não liberado para venda" Style="{StaticResource Subtle}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="JUSTIFICATIVA (opcional)"/>
                        <TextBox x:Name="reasonBox" Margin="0,4,0,0" MinHeight="80"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
