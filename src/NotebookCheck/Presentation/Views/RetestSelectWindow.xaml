<Window x:Class="NotebookCheck.Presentation.Views.RetestSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        Title="Selecionar relatório"
        Width="640" Height="520"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Ink50Brush}"
        WindowStyle="None"
        AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ModalTitleBar Grid.Row="0" Title="Selecionar relatório do reteste"/>

        <DockPanel Grid.Row="1" LastChildFill="True" Margin="22">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource H2}" Text="Qual relatório foi feito anteriormente?"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,14" TextWrapping="Wrap"
                           Text="Escolha o relatório anterior deste equipamento para o reteste dar ênfase nos itens que falharam. Os testes serão refeitos com base nele."/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Click="OnCancel"/>
                <Button Content="Usar o mais recente" Style="{StaticResource BtnGhost}" Click="OnUseLatest"/>
                <Button Content="Usar selecionado" Style="{StaticResource BtnPrimary}" Click="OnConfirm"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="6">
                <ListBox x:Name="list" BorderThickness="0" Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Padding="8,10" FontSize="13"
                                       Foreground="{StaticResource Ink900Brush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</Window>
