<views:TestResultWindow x:Class="NotebookCheck.Presentation.Views.KeyboardTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        xmlns:views="clr-namespace:NotebookCheck.Presentation.Views"
        Title="Teste de teclado"
        Width="1180" Height="600"
        MinWidth="980" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Ink50Brush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=root}"
        KeyDown="OnKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ModalTitleBar Grid.Row="0" Title="Teste de teclado"/>

        <DockPanel Grid.Row="1" x:Name="root" LastChildFill="True" Margin="20" Focusable="True">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Teste do teclado"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Pressione cada tecla — as detectadas ficam verdes. Tecla com defeito? CLIQUE nela para marcar em vermelho. Para o numpad, ative o Num Lock."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,20,0">
                    <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" Text="LAYOUT"/>
                    <ComboBox x:Name="layoutBox" Width="170" VerticalAlignment="Center"
                              SelectionChanged="OnLayoutChanged">
                        <ComboBoxItem Content="ABNT2 (Brasileiro)"/>
                        <ComboBoxItem Content="US ANSI (Inglês)"/>
                    </ComboBox>
                    <CheckBox x:Name="numpadCheck" Content="Numpad" Margin="14,0,0,0" VerticalAlignment="Center"
                              Checked="OnNumpadToggled" Unchecked="OnNumpadToggled"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" Text="DETECTADAS"/>
                    <TextBlock x:Name="counterText" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource OkBrush}"/>
                    <TextBlock VerticalAlignment="Bottom" Margin="6,0,0,2" Foreground="{StaticResource Ink500Brush}" Text="/"/>
                    <TextBlock x:Name="totalText" VerticalAlignment="Bottom" Margin="2,0,0,2" Foreground="{StaticResource Ink500Brush}"/>
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <TextBlock x:Name="failSummary" FontSize="12"
                               Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                               Text="Comentários ficam no botão ＋ do teste, na grade de resultados."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Limpar" Style="{StaticResource BtnGhost}" Click="OnReset"/>
                    <Button Content="Marcar como falho" Style="{StaticResource BtnGhost}" Click="OnFailed"/>
                    <Button Content="Concluir teste" Style="{StaticResource BtnSuccess}" Click="OnComplete"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16">
                <Grid x:Name="layoutHost"/>
            </Border>
        </DockPanel>
    </Grid>
</views:TestResultWindow>
