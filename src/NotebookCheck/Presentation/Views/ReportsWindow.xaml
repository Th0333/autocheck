<Window x:Class="NotebookCheck.Presentation.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        Title="Notelet — Relatórios"
        Width="1100" Height="720"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource Ink50Brush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ModalTitleBar Grid.Row="0" Title="Relatórios"/>

        <DockPanel Grid.Row="1" LastChildFill="True">

        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource Ink200Brush}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Relatórios"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                               Text="Reenvie relatórios offline ou consulte os já recebidos pelo painel"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻ Atualizar" Style="{StaticResource BtnBase}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource Ink200Brush}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Ink600Brush}"/>
                <ProgressBar Grid.Column="1" Width="120" Height="4" IsIndeterminate="True"
                             Background="Transparent" Foreground="{StaticResource BrandBrush}" BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVisConv}}"/>
            </Grid>
        </Border>

        <TabControl Margin="22,18" Background="Transparent" BorderThickness="0">

            <!-- ============================ Offline ============================ -->
            <TabItem Header="Offline (este pendrive)">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="TOTAL"/>
                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" FontSize="20" Text="{Binding LocalTotal}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="SINCRONIZADOS"/>
                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource OkBrush}" Text="{Binding LocalSynced}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="PENDENTES"/>
                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource WarnBrush}" Text="{Binding LocalPending}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="↑ Reenviar todos os pendentes" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding ResendAllPendingCommand}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Subtle}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <Run Text="Arquivo:"/>
                        <Run FontFamily="{StaticResource MonoFont}" Text="{Binding ArchivePath, Mode=OneWay}"/>
                    </TextBlock>

                    <DataGrid ItemsSource="{Binding LocalReports}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NTB" Binding="{Binding NtbCode}" Width="120"/>
                            <DataGridTextColumn Header="Equipamento" Binding="{Binding Equipment}" Width="220"/>
                            <DataGridTextColumn Header="Localização" Binding="{Binding Location}" Width="160"/>
                            <DataGridTextColumn Header="Técnico" Binding="{Binding Technician}" Width="140"/>
                            <DataGridTextColumn Header="Quando" Binding="{Binding TestedAt}" Width="160"/>
                            <DataGridTextColumn Header="Resultado" Binding="{Binding Classification}" Width="160"/>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="999" HorizontalAlignment="Left"
                                                Background="{Binding SyncStatus, Converter={StaticResource StatusBgConv}}">
                                            <TextBlock Text="{Binding SyncStatus}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{Binding SyncStatus, Converter={StaticResource StatusFgConv}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="↑ Reenviar" Style="{StaticResource BtnGhost}"
                                                Command="{Binding DataContext.ResendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ Online ============================ -->
            <TabItem Header="Online (painel)">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Subtle}" Margin="0,12,0,12" TextWrapping="Wrap"
                               Text="Lista dos relatórios já registrados no painel da Vercel/MongoDB. Apenas leitura."/>
                    <DataGrid ItemsSource="{Binding RemoteReports}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NTB" Binding="{Binding NtbCode}" Width="120"/>
                            <DataGridTextColumn Header="Equipamento" Binding="{Binding Equipment}" Width="220"/>
                            <DataGridTextColumn Header="Localização" Binding="{Binding Location}" Width="160"/>
                            <DataGridTextColumn Header="Técnico" Binding="{Binding Technician}" Width="140"/>
                            <DataGridTextColumn Header="Quando" Binding="{Binding TestedAt}" Width="180"/>
                            <DataGridTextColumn Header="Resultado" Binding="{Binding Classification}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        </DockPanel>
    </Grid>
</Window>
