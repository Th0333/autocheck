<views:TestResultWindow x:Class="NotebookCheck.Presentation.Views.MicTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NotebookCheck.Presentation.Controls"
        xmlns:views="clr-namespace:NotebookCheck.Presentation.Views"
        Title="Teste de microfone"
        Width="600" Height="500"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Ink50Brush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:ModalTitleBar Grid.Row="0" Title="Teste de microfone"/>

        <DockPanel Grid.Row="1" LastChildFill="True" Margin="20">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource H2}" Text="🎤 Microfone (nível ao vivo)"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,12" TextWrapping="Wrap"
                           Text="Fale ou faça um som perto do microfone e veja a barra reagir em tempo real. Se o nível sobe ao falar, o microfone está captando."/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Marcar como falho" Style="{StaticResource BtnGhost}" Click="OnFailed"/>
                <Button Content="✓ Funciona" Style="{StaticResource BtnSuccess}" Click="OnOk"/>
            </StackPanel>

            <StackPanel>
                <!-- Seletor de dispositivo (só aparece se houver >1) -->
                <StackPanel x:Name="devicePanel" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource Label}" Text="DISPOSITIVO DE ENTRADA"/>
                    <ComboBox x:Name="deviceBox" Margin="0,6,0,0"
                              SelectionChanged="OnDeviceChanged"/>
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="NÍVEL DE ENTRADA"/>

                        <!-- VU meter segmentado (construído no code-behind) -->
                        <Border Margin="0,8,0,0" Padding="6" CornerRadius="8"
                                Background="{StaticResource Ink900Brush}">
                            <UniformGrid x:Name="meterGrid" Rows="1" Height="40"/>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="statusDot" Width="14" Height="14"
                                         Fill="{StaticResource Ink300Brush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="statusText" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Ink600Brush}"
                                           Text="Aguardando som..."/>
                            </StackPanel>
                            <TextBlock x:Name="levelText" Grid.Column="1" Text="0%"
                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
                        </Grid>
                        <TextBlock x:Name="peakText" Foreground="{StaticResource Ink500Brush}" FontSize="11"
                                   Margin="0,4,0,0" Text="Pico: —"/>
                    </StackPanel>
                </Border>

                <!-- Sem dispositivo -->
                <Border x:Name="noDevicePanel" Style="{StaticResource Card}" Padding="20"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠ Nenhum dispositivo de captura encontrado"
                                   FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource WarnBrush}"/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Verifique se há um microfone conectado e habilitado nas configurações de som do Windows, depois marque o resultado manualmente."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</views:TestResultWindow>
