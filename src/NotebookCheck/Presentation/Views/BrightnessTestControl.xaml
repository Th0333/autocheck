<UserControl x:Class="NotebookCheck.Presentation.Views.BrightnessTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Suportado: slider + atalhos -->
        <Border x:Name="supportedPanel" Style="{StaticResource Card}" Padding="18">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="NÍVEL DE BRILHO"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,8" TextWrapping="Wrap"
                           Text="Arraste e confirme que o brilho responde do mínimo ao máximo. O brilho original é restaurado ao fechar."/>
                <TextBlock x:Name="valueText" Text="—" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource BrandBrush}" Margin="0,0,0,6"/>
                <Slider x:Name="slider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="20"
                        IsSnapToTickEnabled="False" TickFrequency="10" ValueChanged="OnSliderChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Mínimo" Style="{StaticResource BtnBase}" Margin="0,0,8,0" Click="OnMin"/>
                    <Button Content="50%" Style="{StaticResource BtnBase}" Margin="0,0,8,0" Click="OnMid"/>
                    <Button Content="Máximo" Style="{StaticResource BtnBase}" Click="OnMax"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Não suportado -->
        <Border x:Name="unsupportedPanel" Style="{StaticResource Card}" Padding="18" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="⚠ Controle de brilho por software indisponível"
                           FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource WarnBrush}"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="O driver deste painel não expõe ajuste de brilho via WMI (comum em desktops/monitores externos). Ajuste pelas teclas Fn, confirme visualmente e marque o resultado (ou Não aplicável)."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
