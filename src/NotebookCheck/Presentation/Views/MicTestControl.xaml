<UserControl x:Class="NotebookCheck.Presentation.Views.MicTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Seletor de dispositivo (só aparece se houver >1) -->
        <StackPanel x:Name="devicePanel" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Label}" Text="DISPOSITIVO DE ENTRADA"/>
            <ComboBox x:Name="deviceBox" Margin="0,6,0,0" SelectionChanged="OnDeviceChanged"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="18">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="NÍVEL DE ENTRADA"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Fale perto do microfone e veja a barra reagir. Se o nível sobe ao falar, está captando."/>

                <Border Margin="0,10,0,0" Padding="6" CornerRadius="8" Background="{StaticResource DarkPanelBrush}">
                    <UniformGrid x:Name="meterGrid" Rows="1" Height="38"/>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="statusDot" Width="14" Height="14"
                                 Fill="{DynamicResource Ink300Brush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="statusText" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Ink600Brush}" Text="Aguardando som..."/>
                    </StackPanel>
                    <TextBlock x:Name="levelText" Grid.Column="1" Text="0%"
                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
                </Grid>
                <TextBlock x:Name="peakText" Foreground="{DynamicResource Ink500Brush}" FontSize="11"
                           Margin="0,4,0,0" Text="Pico: —"/>
            </StackPanel>
        </Border>

        <!-- ================== Gravação: gravar / ouvir / enviar ================== -->
        <Border x:Name="recorderPanel" Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="GRAVAÇÃO"/>
                    <TextBlock x:Name="recTimeText" Grid.Column="1" Style="{StaticResource Mono}"
                               Foreground="{DynamicResource Ink500Brush}" Text="0:00 / 0:30"/>
                </Grid>

                <TextBlock x:Name="recStateText" Style="{StaticResource Subtle}" Margin="0,6,0,0"
                           TextWrapping="Wrap" Text="Nada gravado ainda. Aperte Gravar e fale perto do microfone."/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="recBtn" Content="● Gravar" Style="{StaticResource BtnPrimary}"
                            Click="OnRecordClick"/>
                    <Button x:Name="playBtn" Content="▶ Ouvir" IsEnabled="False" Click="OnPlayClick"/>
                    <Button x:Name="sendBtn" Content="☁ Enviar pro ERP" IsEnabled="False"
                            Visibility="Collapsed" Click="OnSendClick"/>
                </StackPanel>

                <TextBlock x:Name="sendMsgText" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed" FontSize="12"/>

                <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Limite de 30 segundos por gravação. Gravar de novo descarta a anterior."/>
            </StackPanel>
        </Border>

        <Border x:Name="noDevicePanel" Style="{StaticResource Card}" Padding="18"
                Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="⚠ Nenhum dispositivo de captura encontrado"
                           FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource WarnBrush}"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Verifique se há um microfone conectado e habilitado no Windows, depois marque o resultado."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
