<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>NotebookCheck</RootNamespace>
    <!-- AssemblyName fica NotebookCheck: o nome do .exe é parte do mecanismo de
         auto-update (URL do release, troca do arquivo). A MARCA exibida ao
         usuário (janelas, propriedades do arquivo, Gerenciador de Tarefas) é
         Notelet, via Product/AssemblyTitle abaixo. -->
    <AssemblyName>NotebookCheck</AssemblyName>
    <Product>Notelet</Product>
    <AssemblyTitle>Notelet — Checklist técnico</AssemblyTitle>
    <Company>Notelet</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\notelet.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <!-- Hosting / Configuration -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />

    <!-- HTTP / Resiliency -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Polly" />

    <!-- Logging -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />

    <!-- Hardware / OS Integration -->
    <PackageReference Include="System.Management" />
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="NAudio" />

    <!-- PDF (optional) -->
    <PackageReference Include="QuestPDF" />

    <!-- Direct3D 11 para benchmark de GPU real -->
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Vortice.DXGI" />

    <!-- Monitoring de hardware (temp/clock/power via WinRing0 embutido) -->
    <PackageReference Include="LibreHardwareMonitorLib" />

    <!-- QR code para inspeção física via celular -->
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <!-- Não copiamos mais nenhum config.json para o lado do .exe;
         a configuração agora vive em Bootstrap/AppDefaults.cs e é
         compilada para dentro do executável. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Logo do app (branca, fundo transparente) exibida nas barras de título. -->
    <Resource Include="Assets\notelet-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- CrystalDiskInfo portátil embutido como recurso. Extraído em runtime
         para %TEMP%\NotebookCheck\cdi e executado via /CopyExit (relatório
         SMART) ou GUI completa. -->
    <EmbeddedResource Include="Assets\CrystalDiskInfo.zip">
      <LogicalName>NotebookCheck.Assets.CrystalDiskInfo.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
